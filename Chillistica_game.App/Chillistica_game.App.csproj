<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Version>0.5.0</Version>

    <!-- App runs elevated so it can launch winws.exe (WinDivert) directly. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Chillistica_game</AssemblyName>

    <!-- Keep the framework-dependent single-file build tiny and predictable. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Chillistica_game.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The engine trust manifest is COMPILED INTO the assembly, never shipped as a
      loose file. Distribution is unzip-and-run, so a loose copy would sit in the
      same user-writable folder as the binaries it pins — an attacker who can
      swap winws.exe could swap the manifest too, making the check worthless.
      Embedded, tampering requires replacing the app executable itself, which is
      the binary the user already accepts at the UAC prompt.
    -->
    <EmbeddedResource Include="..\Engine\winws2\trusted-manifest.json">
      <LogicalName>Chillistica_game.trusted-manifest.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!--
      Engine payload shipped next to the app. winws.exe + its native support
      files must be REAL files on disk (ExcludeFromSingleFile) because winws is
      launched as a separate process and loads WinDivert / cygwin from disk.
    -->
    <Content Include="..\Engine\winws2\bin\*">
      <Link>Engine\winws2\bin\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>

    <Content Include="..\Engine\winws2\files\*">
      <Link>Engine\winws2\files\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>

    <Content Include="..\Engine\winws2\strategies\*.json">
      <Link>Engine\winws2\strategies\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>

    <Content Include="..\Engine\winws2\licenses\*.md;..\Engine\winws2\licenses\*.txt">
      <Link>Engine\winws2\licenses\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
