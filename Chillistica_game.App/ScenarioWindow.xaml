<Window x:Class="Chillistica_game.App.ScenarioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Автоматический подбор сценария"
        Width="1180"
        Height="650"
        MinWidth="900"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="#0B0A09">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBackground" Color="#151311"/>
        <SolidColorBrush x:Key="BorderBrushPremium" Color="#302A23"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#3B6A52"/>
        <SolidColorBrush x:Key="MainTextBrush" Color="#F3EDE3"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#999187"/>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource PanelBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource MainTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushPremium}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#27231F"/>
            <Setter Property="RowBackground" Value="#151311"/>
            <Setter Property="AlternatingRowBackground" Value="#1A1714"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeColumns" Value="True"/>
            <Setter Property="CanUserSortColumns" Value="True"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="RowHeight" Value="72"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#211E1A"/>
            <Setter Property="Foreground" Value="#D8D0C5"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushPremium}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="130"/>
            <Setter Property="Foreground" Value="#07140E"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Автоматический подбор сценария"
                       Foreground="{StaticResource MainTextBrush}"
                       FontSize="28"
                       FontWeight="SemiBold"/>

            <TextBlock x:Name="SummaryText"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       FontSize="14"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <Border Grid.Row="2"
                Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource BorderBrushPremium}"
                BorderThickness="1"
                CornerRadius="14">

            <DataGrid x:Name="ScenarioGrid"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Приложение"
                                        Binding="{Binding AppName}"
                                        Width="150"/>

                    <DataGridTextColumn Header="Сценарий"
                                        Binding="{Binding RecommendedMode}"
                                        Width="240"/>

                    <DataGridTextColumn Header="Причина"
                                        Binding="{Binding Reason}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Риск"
                                        Binding="{Binding RiskLevel}"
                                        Width="100"/>

                    <DataGridTextColumn Header="Следующее действие"
                                        Binding="{Binding NextAction}"
                                        Width="350"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Сценарии пока только рассчитаны и ещё не применяются."
                       Foreground="{StaticResource SecondaryTextBrush}"
                       VerticalAlignment="Center"/>

            <Button Grid.Column="1"
                    Content="Закрыть"
                    Style="{StaticResource CloseButtonStyle}"
                    Click="CloseButton_Click"/>
        </Grid>
    </Grid>
</Window>
