<Window x:Class="Chillistica_game.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chillistica_game"
        Width="920"
        Height="620"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#0B0A09"
        KeyDown="Window_KeyDown">

    <Window.Resources>

        <SolidColorBrush x:Key="WindowBackground" Color="#0B0A09"/>
        <SolidColorBrush x:Key="PanelBackground" Color="#151311"/>
        <SolidColorBrush x:Key="PanelSecondary" Color="#1B1815"/>
        <SolidColorBrush x:Key="BorderBrushPremium" Color="#302A23"/>
        <SolidColorBrush x:Key="GoldBrush" Color="#3B6A52"/>
        <SolidColorBrush x:Key="GoldHoverBrush" Color="#477B61"/>
        <SolidColorBrush x:Key="GoldPressedBrush" Color="#315843"/>
        <SolidColorBrush x:Key="MainTextBrush" Color="#F3EDE3"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#999187"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#716A62"/>

        <Style x:Key="PremiumButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{StaticResource MainTextBrush}"/>
            <Setter Property="Background" Value="{StaticResource PanelSecondary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushPremium}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource GoldBrush}"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#211D18"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource PremiumButtonStyle}">
            <Setter Property="Foreground" Value="#07140E"/>
            <Setter Property="Background" Value="{StaticResource GoldBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{StaticResource GoldHoverBrush}"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{StaticResource GoldPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource MainTextBrush}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Margin" Value="0,8,0,8"/>
        </Style>

    </Window.Resources>

    <Grid Background="{StaticResource WindowBackground}">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="4"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource GoldBrush}"/>

            <Grid Grid.Row="1" Margin="32">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="CHILLISTICA"
                               Foreground="{StaticResource GoldBrush}"
                               FontSize="13"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="Chillistica_game"
                               Foreground="{StaticResource MainTextBrush}"
                               FontSize="34"
                               FontWeight="SemiBold"
                               Margin="0,6,0,0"/>

                    <TextBlock Text="Интеллектуальное управление сетевыми сценариями"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="15"
                               Margin="0,8,0,0"/>
                </StackPanel>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{StaticResource PanelBackground}"
                            BorderBrush="{StaticResource BorderBrushPremium}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="24">

                        <StackPanel>
                            <TextBlock Text="СОСТОЯНИЕ"
                                       Foreground="{StaticResource GoldBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"/>

                            <StackPanel Orientation="Horizontal"
                                        Margin="0,16,0,6">

                                <Border Width="18"
                                        Height="18"
                                        Background="#211C17"
                                        BorderBrush="#3B3228"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        Margin="0,2,12,0">

                                    <Ellipse x:Name="StatusIndicator"
                                             Width="8"
                                             Height="8"
                                             Fill="#8C5A4D"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
                                </Border>

                                <TextBlock x:Name="StatusText"
                                           Text="Защита выключена"
                                           Foreground="{StaticResource MainTextBrush}"
                                           FontSize="21"
                                           FontWeight="SemiBold"/>
                            </StackPanel>

                            <TextBlock x:Name="StatusDescription"
                                       Text="Сетевой движок пока не запущен"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="14"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,22"/>

                            <Button x:Name="ToggleProtectionButton"
                                    Content="Включить защиту"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="ToggleProtectionButton_Click"/>

                            <Border Background="#111713"
        BorderBrush="#26392F"
        BorderThickness="1"
        CornerRadius="12"
        Padding="14"
        Margin="0,12,0,0">

    <StackPanel>
        <TextBlock Text="Автоматический режим"
                   Foreground="#D3DDD7"
                   FontSize="14"
                   FontWeight="SemiBold"/>

        <TextBlock Text="После включения программа сама проверит приложения, соединение и выберет подходящий сценарий."
                   Foreground="#8E9992"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,5,0,0"/>
    </StackPanel>
</Border>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Background="{StaticResource PanelBackground}"
                            BorderBrush="{StaticResource BorderBrushPremium}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="20">

                        <StackPanel>
                            <TextBlock Text="ПРОФИЛИ"
                                       Foreground="{StaticResource GoldBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="Приложения"
                                       Foreground="{StaticResource MainTextBrush}"
                                       FontSize="21"
                                       FontWeight="SemiBold"
                                       Margin="0,8,0,0"/>

                            <TextBlock Text="Для каждого приложения будет применяться собственный сетевой сценарий."
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,10"/>

                            <CheckBox x:Name="YouTubeProfile"
                                      Content="YouTube"
                                      IsChecked="True" Margin="0,4,0,2"/>

                            <TextBlock x:Name="YouTubeScenarioText"
                                       Text="Будет определён автоматически"
                                       Foreground="#777F79"
                                       FontSize="11"
                                       Margin="22,-2,0,2"/>

                            <CheckBox x:Name="DiscordProfile"
                                      Content="Discord"
                                      IsChecked="True" Margin="0,4,0,2"/>

                            <TextBlock x:Name="DiscordScenarioText"
                                       Text="Будет определён автоматически"
                                       Foreground="#777F79"
                                       FontSize="11"
                                       Margin="22,-2,0,2"/>

                            <CheckBox x:Name="RobloxProfile"
                                      Content="Roblox"
                                      IsChecked="True" Margin="0,4,0,2"/>

                            <TextBlock x:Name="RobloxScenarioText"
                                       Text="Будет определён автоматически"
                                       Foreground="#777F79"
                                       FontSize="11"
                                       Margin="22,-2,0,2"/>

                            <CheckBox x:Name="FortniteProfile"
                                      Content="Fortnite"
                                      IsChecked="True" Margin="0,4,0,2"/>

                            <TextBlock x:Name="FortniteScenarioText"
                                       Text="Будет определён автоматически"
                                       Foreground="#777F79"
                                       FontSize="11"
                                       Margin="22,-2,0,2"/>

                            <Border Height="1"
                                    Background="{StaticResource BorderBrushPremium}"
                                    Margin="0,16,0,16"/>

                            <TextBlock Text="Игровой режим"
                                       Foreground="{StaticResource MainTextBrush}"
                                       FontSize="16"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="Минимальное вмешательство в UDP и автоматический откат при ухудшении соединения."
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="3"
                        Background="{StaticResource PanelBackground}"
                        BorderBrush="{StaticResource BorderBrushPremium}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14"
                        Margin="0,24,0,0">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Ellipse Grid.Column="0"
                                 Width="6"
                                 Height="6"
                                 Fill="{StaticResource GoldBrush}"
                                 VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="2"
                                   x:Name="EventText"
                                   Text="Готово к настройке"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="13"/>
                    </Grid>
                </Border>

                <Border Grid.Row="4"
                        x:Name="UpdateBanner"
                        Visibility="Collapsed"
                        Background="{StaticResource PanelBackground}"
                        BorderBrush="{StaticResource GoldBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14"
                        Margin="0,12,0,0">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   x:Name="UpdateBannerText"
                                   Text="Доступно обновление"
                                   Foreground="{StaticResource MainTextBrush}"
                                   FontSize="13"
                                   VerticalAlignment="Center"/>

                        <Button Grid.Column="1"
                                x:Name="UpdateNowButton"
                                Content="Обновить"
                                Click="UpdateNowButton_Click"/>

                        <Button Grid.Column="3"
                                x:Name="DismissUpdateButton"
                                Content="Позже"
                                Click="DismissUpdateButton_Click"/>
                    </Grid>
                </Border>

            </Grid>
        </Grid>
    </Grid>
</Window>












