            "StrategyId": "discord-full-tcp-quic-voice",
            "Description": "Full Discord coverage in one strategy: TCP 443 web/API/CDN (proven TLS fake+multidisorder), QUIC on UDP 443, and voice via winws1's native --filter-l7=discord,stun on Discord voice UDP ports. The TCP part is KnownGood; the voice/STUN part is best-effort but non-fatal (only L7-matching packets are desynced, all other UDP passes through). Voice ports 19294-19344,50000-50100 sourced from Flowseal/zapret-discord-youtube (see licenses/FLOWSEAL_NOTICE.md).",
            "TcpPorts": "443",
            "UdpPorts": "443,19294-19344,50000-50100",
            "UsesUdp": true,
            "Confidence": "KnownGood",
            "ArgumentsFragment": "--filter-tcp=443 --hostlist=\"files\\list-discord.txt\" --dpi-desync=fake,multidisorder --dpi-desync-split-pos=1,midsld --dpi-desync-repeats=11 --dpi-desync-fooling=md5sig --dpi-desync-fake-tls-mod=rnd,dupsid,sni=www.google.com --new --filter-udp=443 --filter-l7=quic --hostlist=\"files\\list-discord.txt\" --dpi-desync=fake --dpi-desync-repeats=11 --dpi-desync-fake-quic=\"files\\quic_initial_www_google_com.bin\" --new --filter-udp=19294-19344,50000-50100 --filter-l7=discord,stun --dpi-desync=fake --dpi-desync-repeats=6",
