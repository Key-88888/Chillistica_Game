<Window x:Class="Chillistica_game.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chillistica_game"
        Width="920"
        Height="620"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#101114">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#292C33"/>
            <Setter Property="BorderBrush" Value="#3A3E47"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E8E8EA"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Margin" Value="0,8,0,8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Chillistica_game"
                       Foreground="White"
                       FontSize="32"
                       FontWeight="SemiBold"/>

            <TextBlock Text="Автоматическая настройка соединений для приложений"
                       Foreground="#9297A3"
                       FontSize="15"
                       Margin="0,8,0,0"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#181A1F"
                    BorderBrush="#2B2E35"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="24">

                <StackPanel>
                    <TextBlock Text="Состояние"
                               Foreground="#9297A3"
                               FontSize="14"/>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,6">
                        <Ellipse x:Name="StatusIndicator"
                                 Width="14"
                                 Height="14"
                                 Fill="#E05A5A"
                                 Margin="0,4,10,0"/>

                        <TextBlock x:Name="StatusText"
                                   Text="Защита выключена"
                                   Foreground="White"
                                   FontSize="21"
                                   FontWeight="SemiBold"/>
                    </StackPanel>

                    <TextBlock x:Name="StatusDescription"
                               Text="Сетевой движок пока не запущен"
                               Foreground="#9297A3"
                               FontSize="14"
                               TextWrapping="Wrap"
                               Margin="0,0,0,20"/>

                    <Button x:Name="ToggleProtectionButton"
                            Content="Включить защиту"
                            Background="#4169E1"
                            BorderBrush="#5578E5"
                            Click="ToggleProtectionButton_Click"/>

                    <Button Content="Запустить диагностику"
                            Click="DiagnosticsButton_Click"/>

                    <Button Content="Подобрать сценарий автоматически"
                            Click="AutoTuneButton_Click"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="#181A1F"
                    BorderBrush="#2B2E35"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="24">

                <StackPanel>
                    <TextBlock Text="Профили приложений"
                               Foreground="White"
                               FontSize="20"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="Для каждой программы будет применяться собственный сценарий."
                               Foreground="#9297A3"
                               TextWrapping="Wrap"
                               Margin="0,8,0,18"/>

                    <CheckBox x:Name="YouTubeProfile"
                              Content="YouTube"
                              IsChecked="True"/>

                    <CheckBox x:Name="DiscordProfile"
                              Content="Discord"
                              IsChecked="True"/>

                    <CheckBox x:Name="RobloxProfile"
                              Content="Roblox"
                              IsChecked="True"/>

                    <CheckBox x:Name="FortniteProfile"
                              Content="Fortnite"
                              IsChecked="True"/>

                    <Separator Margin="0,16,0,14"
                               Background="#30333A"/>

                    <TextBlock Text="Игровой режим"
                               Foreground="White"
                               FontSize="16"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="Минимальное вмешательство в UDP и автоматический откат при ухудшении соединения."
                               Foreground="#9297A3"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3"
                Background="#181A1F"
                BorderBrush="#2B2E35"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14"
                Margin="0,24,0,0">

            <TextBlock x:Name="EventText"
                       Text="Готово к настройке"
                       Foreground="#AEB2BC"
                       FontSize="13"/>
        </Border>
    </Grid>
</Window>
